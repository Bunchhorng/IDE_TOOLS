# Caddy config for the ETEC STUDIO production VM.
# Install:  sudo cp docker/caddy/Caddyfile /etc/caddy/Caddyfile
# Pre-req:  DNS A records for etecstudio.online and www.etecstudio.online
#           must point at the VM's public IP, and ports 80/443 open.
etecstudio.online {
    encode gzip
    reverse_proxy 127.0.0.1:80
}

www.etecstudio.online {
    redir https://etecstudio.online{uri} permanent
}