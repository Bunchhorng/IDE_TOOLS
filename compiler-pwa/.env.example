# Application
APP_NAME=CodeRunner
APP_ENV=local
APP_DEBUG=true
APP_KEY=base64:95ObMnk6oNIcFxdv/ft1Nh+zAlhcLu3uX3d3BlGiMvI=

# Database
DB_DATABASE=compiler
DB_USERNAME=compiler
DB_PASSWORD=secret
DB_ROOT_PASSWORD=rootsecret

# Execution sandbox limits
EXECUTION_TIMEOUT=5
EXECUTION_INTERACTIVE_TIMEOUT=120
EXECUTION_MEMORY_LIMIT=134217728
EXECUTION_OUTPUT_LIMIT=1000000
EXECUTION_RATE_PER_MINUTE=5
EXECUTION_RATE_PER_HOUR=50

# Host path to backend source (used by Docker bind mounts on the host daemon)
EXECUTION_HOST_BASE=/path/to/compiler-pwa/backend